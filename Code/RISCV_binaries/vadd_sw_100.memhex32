@20000000    // 80000000
/// ----------------
/// Initialization of N, &vA, &vB, &vC
             /// N = 100
06406093  // 80000000: ori  x1, x0, 100    (0x064)
             /// pA = 0x80011000
80011137  // 80000004: lui  x2, 524305    (0x80011)
             /// pB = 0x80012000
800121b7  // 80000008: lui  x3, 524306    (0x80012)
             /// pC = 0x80013000
80013237  // 8000000c: lui  x4, 524307    (0x80013)
/// ----------------
/// LOOP:
             /// vAj = *pA
00012603  // 80000010: lw  x12, 0(x2)
             /// vBj = *pB
0001a683  // 80000014: lw  x13, 0(x3)
             /// pA += 4
00410113  // 80000018: addi  x2, x2, 4    (0x004)
             /// pB += 4
00418193  // 8000001c: addi  x3, x3, 4    (0x004)
             /// vCj = vAj + vBj
00d60713  // 80000020: add  x14, x13, x12
             /// N -= 1
fff08093  // 80000024: addi  x1, x1, -1    (0x-01)
             /// *pC = vCj
00e22023  // 80000028: sw  x14, 0(x4)
             /// pC += 4
00420213  // 8000002c: addi  x4, x4, 4    (0x004)
             /// if N != 0 goto LOOP
fe0090e3  // 80000030: bne  x1, x0, -32    (0x-020)
/// ----------------
/// END
/// ----------------
/// EXIT_LOOP:
             /// x1 = 0x6fff0010
6fff00b7  // 80000034: lui  x1, 458736    (0x6fff0)
             /// ...
0100e093  // 80000038: ori  x1, x1, 16    (0x010)
             /// x2 = 1
00100113  // 8000003c: addi  x2, x0, 1    (0x001)
             /// *pToHost = x2
0020a023  // 80000040: sw  x2, 0(x1)
             /// goto EXIT_LOOP
ff9ff06f  // 80000044: jal  x0, -8    (0x-8)
